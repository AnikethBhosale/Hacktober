generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite"; url = env("DATABASE_URL") }

model Incident {
  id String @id
  status String
  payload Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Correction {
  id String @id @default(cuid())
  incidentId String
  category String
  reason String
  action String
  createdAt DateTime @default(now())
}
